            </th>
            <td data-label="当前">
              "0"
            </td>
            <td data-label="候选">
              "+12"
            </td>
            <td class="loot-compare-delta" data-label="差值">
              "+12"
            </td>
          </tr>
          <tr class="loot-compare-row loot-compare-better">
            <th>
